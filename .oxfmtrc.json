{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "vendor/",
    "public/i18n/",
    "public/config/",
    "fm-data/",
    "reports/",
    "coverage/",
    "playwright-report/",
    "test-results/",
    "pnpm-lock.yaml",
    "*.csv",
    "e2e/fixtures/*.html",
    "eslint-suppressions.json",
    "goldens/"
  ]
}
