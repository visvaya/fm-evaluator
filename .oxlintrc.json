      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "no-var": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "camelCase": true,
          "pascalCase": true
        },
        "ignore": [
          "\\.d\\.ts$",
          "\\.worker\\.ts$",
          "service-worker",
          "\\.spec\\.tsx?$",
          "\\.test\\.tsx?$"
        ]
      }
    ],
    "import/no-cycle": [
      "error",
      {
        "ignoreExternal": true
      }
    ], // No depth limit: replaces the dependency-cruiser no-circular rule.
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-optional-chain": "error", // Nursery rule; on TypeScript its findings match ESLint's (off for plain JavaScript below).
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": false }], // Also string arrays: a default sort compares UTF-16 code units, not the locale (replaces sonarjs/no-alphabetical-sort).
    "typescript/switch-exhaustiveness-check": "error",
    "array-callback-return": "error",
    "import/no-named-default": "error",
    "oxc/branches-sharing-code": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "DOMParser",
        "message": "Use htmlparser2 (streaming parser) instead of DOMParser."
      }
    ], // Data processing parses HTML with htmlparser2.
    "no-new-func": "error", // The strict CSP forbids eval and new Function.
    "max-classes-per-file": [
      "error",
      {
        "max": 0
      }
    ], // Functional over OOP: no classes (replaces the ClassDeclaration no-restricted-syntax rule).
    "id-match": [
      "error",
      "^_?([a-z][a-zA-Z0-9]*|[A-Z][a-zA-Z0-9]*|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$",
      {
        "onlyDeclarations": true,
        "ignoreDestructuring": true,
        "properties": false
      }
    ], // Variables and functions: camelCase, PascalCase or UPPER_CASE (stands in for typescript-eslint naming-convention).
    "comments/english-only": "error", // Code comments in English: Polish letters in a comment fail (local plugin).
    "naming/naming-convention": "error", // Types, enum members, type parameters and parameters: the rest of naming-convention (local plugin).
    "no-useless-assignment": "error", // Nursery rule kept from eslint:recommended (findings match ESLint).
    "import/named": "error",
    "import/export": "error",
    "promise/no-return-in-finally": "error",
    "unicorn/no-useless-iterator-to-array": "error",
