{
  "name": "fm-evaluator",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "preview": "vite preview",
    "sri:check": "node scripts/generate-sri.cjs --check",
    "sri:update": "node scripts/generate-sri.cjs --update",
    "sri:list": "node scripts/generate-sri.cjs",
    "validate:configs": "node scripts/validate-configs.cjs",
    "validate:configs:check": "node scripts/validate-configs.cjs --check",
    "validate:all": "pnpm run sri:check && pnpm run validate:configs:check",
    "deps:report": "pnpm outdated",
    "test": "vitest run --configLoader native",
    "test:coverage": "vitest run --configLoader native --coverage",
    "test:watch": "vitest --configLoader native",
    "test:runner": "vitest run --configLoader runner",
    "test:bundle": "vitest run --configLoader bundle",
    "test:goldens": "vitest run src/data/importPipeline.golden.test.ts --configLoader native",
    "test:goldens:update": "vitest run src/data/importPipeline.golden.test.ts --configLoader native -u",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "e2e:local": "node scripts/e2e-local.mjs",
    "lint": "oxlint",
    "lint:prune": "oxlint --prune-suppressions",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "quality:deps": "pnpm run deps:report && pnpm run audit:prod",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "jscpd": "jscpd src/",
    "legacy:codemap": "node scripts/legacy-codemap.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "goldens:compare": "node scripts/compare-parse-paths.cjs",
    "goldens:diff": "node scripts/goldens-diff.mjs",
    "legacy:metrics": "node scripts/legacy-metrics.mjs",
    "legacy:metrics:check": "node scripts/legacy-metrics.mjs --check",
    "legacy:metrics:update": "node scripts/legacy-metrics.mjs --update",
    "strict:metrics": "node scripts/strict-metrics.mjs",
    "strict:metrics:check": "node scripts/strict-metrics.mjs --check",
    "strict:metrics:update": "node scripts/strict-metrics.mjs --update",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run jscpd && pnpm run legacy:metrics:check && pnpm run strict:metrics:check && pnpm run docs:check && pnpm run check:typography",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:prod": "pnpm audit --audit-level=moderate --prod",
    "ci": "pnpm run format:check && pnpm run quality && pnpm run audit:prod && pnpm run test:coverage && pnpm run build && pnpm run check:dist"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*": [
      "node scripts/check-typography.mjs"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/typescript-estree": "8.59.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-fp": "^2.3.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@visx/scale": "4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "fuse.js": "6.6.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
