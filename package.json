{
  "name": "fm-evaluator",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "preview": "vite preview",
    "sri:check": "node scripts/generate-sri.cjs --check",
    "sri:update": "node scripts/generate-sri.cjs --update",
    "sri:list": "node scripts/generate-sri.cjs",
    "validate:configs": "node scripts/validate-configs.cjs",
    "validate:configs:check": "node scripts/validate-configs.cjs --check",
    "validate:all": "pnpm run sri:check && pnpm run validate:configs:check",
    "deps:report": "pnpm outdated",
    "test": "vitest run --configLoader native",
    "test:coverage": "vitest run --configLoader native --coverage",
    "test:watch": "vitest --configLoader native",
    "test:runner": "vitest run --configLoader runner",
    "test:bundle": "vitest run --configLoader bundle",
    "test:goldens": "vitest run src/data/importPipeline.golden.test.ts --configLoader native",
    "test:goldens:update": "vitest run src/data/importPipeline.golden.test.ts --configLoader native -u",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "e2e:local": "node scripts/e2e-local.mjs",
    "lint": "eslint . --max-warnings=466",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "type-coverage": "type-coverage --ignore-catch --at-least 0",
    "quality:deps": "pnpm run deps:report && pnpm run audit:prod",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "jscpd": "jscpd src/",
    "legacy:codemap": "node scripts/legacy-codemap.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "goldens:compare": "node scripts/compare-parse-paths.cjs",
    "goldens:diff": "node scripts/goldens-diff.mjs",
    "legacy:metrics": "node scripts/legacy-metrics.mjs",
    "legacy:metrics:check": "node scripts/legacy-metrics.mjs --check",
    "legacy:metrics:update": "node scripts/legacy-metrics.mjs --update",
    "strict:metrics": "node scripts/strict-metrics.mjs",
    "strict:metrics:check": "node scripts/strict-metrics.mjs --check",
    "strict:metrics:update": "node scripts/strict-metrics.mjs --update",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run type-coverage && pnpm run knip && pnpm run jscpd && pnpm run depcruise && pnpm run legacy:metrics:check && pnpm run strict:metrics:check && pnpm run docs:check && pnpm run check:typography",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:prod": "pnpm audit --audit-level=moderate --prod",
    "ci": "pnpm run format:check && pnpm run quality && pnpm run audit:prod && pnpm run test:coverage && pnpm run build && pnpm run check:dist"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --no-warn-ignored --pass-on-unpruned-suppressions",
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "eslint --no-warn-ignored --pass-on-unpruned-suppressions",
      "prettier --write"
    ],
    "*.{json,md,mjs,cjs}": [
      "prettier --write"
    ],
    "*": [
      "node scripts/check-typography.mjs"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/typescript-estree": "8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-fp": "^2.3.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.2",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-zod": "4.4.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^4.2.3",
    "jsdom": "^29.1.1",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "type-coverage": "^2.31.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@visx/scale": "3.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dexie": "^4.4.2",
    "fuse.js": "6.6.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "tesseract.js",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "typescript": "6"
      }
    }
  }
}
